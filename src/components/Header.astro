---
import { locales, localeNames, pagePath, type Locale, type PageKey } from '../i18n';
import { getDictionary } from '../i18n';
import { CHECKOUT_URL } from '../config';

interface Props {
	locale: Locale;
	page: PageKey;
	langLinks?: Partial<Record<Locale, string>>;
}
const { locale, page, langLinks } = Astro.props;
const dict = getDictionary(locale);
---
<header class="ct-header">
	<div class="ct-container ct-header-inner">
		<a href={pagePath(locale, 'home')} class="ct-logo">clickTarot <span>Calendar</span></a>

		<nav class="ct-nav" aria-label="Main">
			<a href={pagePath(locale, 'home')}>{dict.nav.home}</a>
			<a href={pagePath(locale, 'pricing')}>{dict.nav.pricing}</a>
			<a href={pagePath(locale, 'faq')}>{dict.nav.faq}</a>
			<a href={pagePath(locale, 'about')}>{dict.nav.about}</a>
		</nav>

		<div class="ct-header-actions">
			<label class="ct-lang-switch-label">
				<span class="sr-only">Language</span>
				<select class="ct-lang-select" data-lang-select>
					{locales.map((l) => (
						<option value={langLinks?.[l] ?? pagePath(l, page)} selected={l === locale}>
							{l.toUpperCase()} — {localeNames[l]}
						</option>
					))}
				</select>
			</label>
			<a class="ct-btn ct-btn-primary ct-header-cta" href={CHECKOUT_URL} target="_blank" rel="noopener">
				{dict.pricing.ctaLabel}
			</a>
			<button type="button" class="ct-menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="ct-mobile-nav">
				<span class="sr-only">Menu</span>
				<span class="ct-menu-icon"></span>
			</button>
		</div>
	</div>

	<div class="ct-mobile-nav" id="ct-mobile-nav" data-mobile-nav>
		<a href={pagePath(locale, 'home')}>{dict.nav.home}</a>
		<a href={pagePath(locale, 'pricing')}>{dict.nav.pricing}</a>
		<a href={pagePath(locale, 'faq')}>{dict.nav.faq}</a>
		<a href={pagePath(locale, 'about')}>{dict.nav.about}</a>
		<a class="ct-btn ct-btn-primary ct-mobile-cta" href={CHECKOUT_URL} target="_blank" rel="noopener">
			{dict.pricing.ctaLabel}
		</a>
	</div>
</header>

<script>
	document.querySelectorAll<HTMLSelectElement>('[data-lang-select]').forEach((select) => {
		select.addEventListener('change', () => {
			const url = select.value;
			if (url) window.location.href = url;
		});
	});

	document.querySelectorAll<HTMLButtonElement>('[data-menu-toggle]').forEach((btn) => {
		btn.addEventListener('click', () => {
			const expanded = btn.getAttribute('aria-expanded') === 'true';
			btn.setAttribute('aria-expanded', String(!expanded));
			const nav = document.querySelector('[data-mobile-nav]');
			nav?.classList.toggle('is-open', !expanded);
		});
	});
</script>

<style>
	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}
	.ct-header {
		border-bottom: 1px solid var(--ct-border);
		background: var(--ct-surface);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.ct-header-inner {
		display: flex;
		align-items: center;
		gap: 24px;
		padding-top: 14px;
		padding-bottom: 14px;
	}
	.ct-logo {
		font-weight: 800;
		font-size: 18px;
		color: var(--ct-ink);
		text-decoration: none;
		white-space: nowrap;
	}
	.ct-logo span {
		color: var(--ct-primary-dark);
	}
	.ct-nav {
		display: flex;
		gap: 20px;
		flex: 1;
	}
	.ct-nav a {
		color: var(--ct-ink-soft);
		text-decoration: none;
		font-size: 15px;
		font-weight: 500;
	}
	.ct-nav a:hover {
		color: var(--ct-primary-dark);
	}
	.ct-header-actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.ct-lang-select {
		appearance: none;
		background: var(--ct-bg);
		border: 1px solid var(--ct-border);
		border-radius: 8px;
		color: var(--ct-ink);
		font-size: 13px;
		font-weight: 600;
		padding: 7px 10px;
		cursor: pointer;
	}
	.ct-header-cta {
		padding: 9px 18px;
		font-size: 14px;
		white-space: nowrap;
	}
	.ct-menu-toggle {
		display: none;
		width: 36px;
		height: 36px;
		align-items: center;
		justify-content: center;
		background: transparent;
		border: 1px solid var(--ct-border);
		border-radius: 8px;
		cursor: pointer;
		padding: 0;
	}
	.ct-menu-icon,
	.ct-menu-icon::before,
	.ct-menu-icon::after {
		display: block;
		width: 18px;
		height: 2px;
		background: var(--ct-ink);
		position: relative;
		transition: transform 0.15s ease;
	}
	.ct-menu-icon::before,
	.ct-menu-icon::after {
		content: '';
		position: absolute;
	}
	.ct-menu-icon::before {
		top: -6px;
	}
	.ct-menu-icon::after {
		top: 6px;
	}
	.ct-mobile-nav {
		display: none;
	}

	@media (max-width: 780px) {
		.ct-nav {
			display: none;
		}
		.ct-header-cta {
			display: none;
		}
		.ct-menu-toggle {
			display: flex;
			flex-shrink: 0;
		}
		.ct-header-inner {
			gap: 10px;
		}
		.ct-logo {
			font-size: 16px;
			min-width: 0;
			overflow: hidden;
			text-overflow: ellipsis;
		}
		.ct-header-actions {
			gap: 8px;
			flex-shrink: 0;
		}
		.ct-lang-select {
			max-width: 84px;
			overflow: hidden;
			text-overflow: ellipsis;
			padding: 7px 6px;
			font-size: 12px;
		}
		.ct-mobile-nav {
			display: none;
			flex-direction: column;
			gap: 2px;
			border-top: 1px solid var(--ct-border);
			padding: 8px 24px 16px;
		}
		.ct-mobile-nav.is-open {
			display: flex;
		}
		.ct-mobile-nav a {
			color: var(--ct-ink);
			text-decoration: none;
			font-weight: 600;
			padding: 12px 4px;
			border-bottom: 1px solid var(--ct-border);
		}
		.ct-mobile-cta {
			margin-top: 10px;
			text-align: center;
			border-bottom: none !important;
		}
	}
</style>
