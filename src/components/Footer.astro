---
import { pagePath, type Locale, type PageKey } from '../i18n';
import { getDictionary } from '../i18n';
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../config';

interface Props {
	locale: Locale;
	page: PageKey;
}
const { locale } = Astro.props;
const dict = getDictionary(locale);
const year = new Date().getFullYear();
---
<footer class="ct-footer">
	<div class="ct-container ct-footer-inner">
		<div>
			<div class="ct-logo">clickTarot <span>Calendar</span></div>
			<p class="ct-hint" set:html={dict.footer.tagline} />
		</div>
		<div class="ct-footer-links">
			<a href={`mailto:${CONTACT_EMAIL}`}>{dict.footer.contactLabel}</a>
			<a href={pagePath(locale, 'support')}>{dict.footer.supportLabel}</a>
			<a href={pagePath(locale, 'privacy')}>{dict.footer.privacy}</a>
			<a href={pagePath(locale, 'terms')}>{dict.footer.terms}</a>
			<div class="ct-footer-social">
				<a href={SOCIAL_LINKS.instagram} target="_blank" rel="noopener" aria-label="Instagram">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<rect x="3" y="3" width="18" height="18" rx="5" />
						<circle cx="12" cy="12" r="4.2" />
						<circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
					</svg>
				</a>
				<a href={SOCIAL_LINKS.facebook} target="_blank" rel="noopener" aria-label="Facebook">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<path d="M15 8.5h2V5h-2c-2.2 0-4 1.8-4 4v2.5H9V15h2v6h3v-6h2.4l.6-3.5H14V9c0-.6.4-.5 1-.5Z" />
					</svg>
				</a>
				<a href={SOCIAL_LINKS.youtube} target="_blank" rel="noopener" aria-label="YouTube">
					<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
						<rect x="3" y="6" width="18" height="12" rx="4" />
						<path d="M10.5 9.7v4.6l4-2.3-4-2.3Z" fill="currentColor" stroke="none" />
					</svg>
				</a>
			</div>
		</div>
	</div>
	<div class="ct-container">
		<p class="ct-hint ct-copyright">© {year} clickTarot Calendar. {dict.footer.rights}</p>
		<p class="ct-hint ct-copyright ct-freemius-note">{dict.footer.freemiusNote}</p>
	</div>
</footer>

<style>
	.ct-footer {
		border-top: 1px solid var(--ct-border);
		padding: 40px 0 24px;
		margin-top: 48px;
	}
	.ct-footer-inner {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 24px;
		flex-wrap: wrap;
		padding-bottom: 20px;
	}
	.ct-footer .ct-logo {
		font-weight: 800;
		font-size: 16px;
	}
	.ct-footer .ct-logo span {
		color: var(--ct-primary-dark);
	}
	.ct-footer-links {
		display: flex;
		gap: 20px;
	}
	.ct-footer-links a {
		color: var(--ct-ink-soft);
		text-decoration: none;
		font-size: 14px;
	}
	.ct-footer-links a:hover {
		color: var(--ct-primary-dark);
	}
	.ct-footer-social {
		display: flex;
		align-items: center;
		gap: 14px;
	}
	.ct-footer-social a {
		display: inline-flex;
		color: var(--ct-ink-soft);
	}
	.ct-footer-social a:hover {
		color: var(--ct-primary-dark);
	}
	.ct-copyright {
		margin: 0;
		font-size: 13px;
	}
	.ct-freemius-note {
		margin-top: 4px;
		opacity: 0.75;
	}
</style>
