---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PricingContent from '../../sections/PricingContent.astro';
import { getDictionary } from '../../i18n';
const locale = 'it' as const;
const dict = getDictionary(locale);
---
<BaseLayout locale={locale} page="pricing" title={`${dict.pricing.title} — clickTarot Calendar`} description={dict.pricing.subtitle}>
	<PricingContent locale={locale} />
</BaseLayout>
