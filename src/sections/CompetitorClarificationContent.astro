---
import { getDictionary, type Locale } from '../i18n';
import { competitorPath, type ClarificationDetail } from '../i18n/competitors';
import CtaButton from '../components/CtaButton.astro';
import { CHECKOUT_URL } from '../config';

interface Props {
	locale: Locale;
	content: ClarificationDetail;
}
const { locale, content: c } = Astro.props;
const dict = getDictionary(locale);
const [clarifyQuestion, clarifyAnswer] = c.title.split('? ');
---
<section class="ct-section">
	<div class="ct-container ct-clarify-head">
		<p class="ct-eyebrow">{c.eyebrow}</p>
		<h1>{clarifyQuestion}? <span class="ct-accent">{clarifyAnswer}</span></h1>
		<p class="ct-hint">{c.subtitle}</p>
	</div>
</section>

<section class="ct-section ct-section-alt">
	<div class="ct-container ct-clarify-body">
		<article class="ct-card ct-clarify-block">
			<h2>{c.whatItIsTitle}</h2>
			<p>{c.whatItIsBody}</p>
		</article>
		<article class="ct-card ct-clarify-block">
			<h2>{c.whyNotFitTitle}</h2>
			<p>{c.whyNotFitBody}</p>
		</article>
	</div>
</section>

<section class="ct-section">
	<div class="ct-container ct-clarify-link">
		<a href={competitorPath(locale, 'booknetic')}>{c.realComparisonLabel}</a>
	</div>
</section>

<section class="ct-section ct-section-alt">
	<div class="ct-container ct-final-cta">
		<h2>{c.ctaTitle}</h2>
		<p class="ct-hint">{c.ctaBody}</p>
		<CtaButton href={CHECKOUT_URL} external>{dict.pricing.ctaLabel}</CtaButton>
	</div>
</section>

<style>
	.ct-clarify-head {
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
	}
	.ct-clarify-body {
		display: grid;
		gap: 20px;
		max-width: 760px;
		margin: 0 auto;
	}
	.ct-clarify-block h2 {
		margin: 0 0 10px;
		font-size: 18px;
	}
	.ct-clarify-block p {
		margin: 0;
		color: var(--ct-ink-soft);
	}
	.ct-clarify-link {
		text-align: center;
	}
	.ct-clarify-link a {
		display: inline-block;
		padding: 14px 20px;
		border: 1px solid var(--ct-border);
		border-radius: var(--ct-radius);
		color: var(--ct-ink);
		text-decoration: none;
		font-weight: 600;
	}
	.ct-clarify-link a:hover {
		border-color: var(--ct-primary-dark);
		color: var(--ct-primary-dark);
	}
	.ct-final-cta {
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}
	.ct-final-cta p {
		margin: 12px 0 24px;
	}
</style>
