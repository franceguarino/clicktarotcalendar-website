---
import { getDictionary, pagePath, type Locale } from '../i18n';
import CtaButton from '../components/CtaButton.astro';
import FeatureCard from '../components/FeatureCard.astro';
import { featureKeys, featurePath } from '../i18n/features';
import { CHECKOUT_URL } from '../config';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const dict = getDictionary(locale);
---
<section class="ct-section ct-hero">
	<div class="ct-container ct-hero-grid">
		<div>
			<p class="ct-eyebrow">{dict.hero.eyebrow}</p>
			<h1 set:html={dict.hero.title} />
			<p class="ct-hero-subtitle">{dict.hero.subtitle}</p>
			<div class="ct-hero-actions">
				<CtaButton href={CHECKOUT_URL} external>{dict.pricing.ctaLabel}</CtaButton>
			</div>
		</div>
		<div class="ct-hero-image">
			<img src="/hero-customer.png" alt={dict.hero.imageAlt} />
		</div>
	</div>
</section>

<section class="ct-section">
	<div class="ct-container">
		<h2 set:html={dict.features.title} />
		<div class="ct-features-grid">
			{dict.features.items.map((item, i) => (
				<FeatureCard
					title={item.title}
					description={item.description}
					href={i < featureKeys.length ? featurePath(locale, featureKeys[i]) : undefined}
				/>
			))}
		</div>
	</div>
</section>

<section class="ct-section ct-section-alt">
	<div class="ct-container">
		<h2>{dict.screenshots.title}</h2>
		<div class="ct-screens-grid">
			{dict.screenshots.items.map((s, i) => (
				<figure class="ct-card">
					<span class="ct-step-number">{i + 1}</span>
					<div class="ct-screen-image">
						<img src={s.src} alt={s.alt} />
					</div>
					<figcaption>{s.caption}</figcaption>
				</figure>
			))}
		</div>
	</div>
</section>

<section class="ct-section">
	<div class="ct-container ct-audience">
		<h2 set:html={dict.audience.title} />
		<p class="ct-hint">{dict.audience.body}</p>
	</div>
</section>

<section class="ct-section ct-section-alt">
	<div class="ct-container ct-final-cta">
		<h2 set:html={dict.pricing.title} />
		<p class="ct-hint">{dict.pricing.subtitle}</p>
		<CtaButton href={CHECKOUT_URL} external>{dict.pricing.ctaLabel}</CtaButton>
	</div>
</section>

<style>
	.ct-hero-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 40px;
		align-items: center;
	}
	.ct-hero h1 {
		font-size: clamp(32px, 4vw, 44px);
		margin: 0 0 16px;
	}
	.ct-hero-subtitle {
		font-size: 18px;
		color: var(--ct-ink-soft);
		margin: 0 0 28px;
	}
	.ct-hero-actions {
		display: flex;
		gap: 14px;
		flex-wrap: wrap;
	}
	.ct-hero-image img {
		border-radius: var(--ct-radius);
		box-shadow: var(--ct-shadow);
		border: 1px solid var(--ct-border);
	}
	.ct-section-alt {
		background: var(--ct-surface);
	}
	.ct-features-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
		gap: 20px;
		margin-top: 32px;
	}
	.ct-screens-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 20px;
		margin-top: 32px;
	}
	.ct-screens-grid figure {
		margin: 0;
		padding: 24px;
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.ct-step-number {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 28px;
		height: 28px;
		border-radius: 999px;
		background: var(--ct-primary);
		color: #fff;
		font-weight: 700;
		font-size: 14px;
		flex-shrink: 0;
	}
	.ct-screen-image {
		height: 240px;
		display: flex;
		align-items: flex-start;
		justify-content: center;
		overflow: hidden;
		background: var(--ct-bg);
		border-radius: var(--ct-radius);
	}
	.ct-screen-image img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		object-position: top;
	}
	.ct-screens-grid figcaption {
		font-weight: 600;
		font-size: 15px;
		line-height: 1.4;
	}
	.ct-audience {
		max-width: 760px;
		text-align: center;
		margin: 0 auto;
	}
	.ct-audience p {
		font-size: 17px;
	}
	.ct-final-cta {
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}
	.ct-final-cta p {
		margin: 12px 0 24px;
	}

	@media (max-width: 780px) {
		.ct-hero-grid {
			grid-template-columns: 1fr;
		}
		.ct-hero-image {
			order: -1;
		}
	}
</style>
