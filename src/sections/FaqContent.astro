---
import { getDictionary, type Locale } from '../i18n';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const dict = getDictionary(locale);
---
<section class="ct-section">
	<div class="ct-container ct-faq-wrap">
		<h1>{dict.faq.title}</h1>
		<div class="ct-faq-list">
			{dict.faq.items.map((item) => (
				<details class="ct-card ct-faq-item">
					<summary>{item.q}</summary>
					<p class="ct-hint">{item.a}</p>
				</details>
			))}
		</div>
	</div>
</section>

<style>
	.ct-faq-wrap {
		max-width: 760px;
		margin: 0 auto;
	}
	.ct-faq-list {
		display: grid;
		gap: 14px;
		margin-top: 32px;
	}
	.ct-faq-item summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 16px;
	}
	.ct-faq-item p {
		margin: 12px 0 0;
	}
</style>
