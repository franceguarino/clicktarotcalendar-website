---
import { getDictionary, type Locale } from '../i18n';
import { competitorKeys, competitorNames, competitorPath, bookneticSaasPath, type CompetitorDetail, type CompetitorKey } from '../i18n/competitors';
import CtaButton from '../components/CtaButton.astro';
import { CHECKOUT_URL } from '../config';

interface Props {
	locale: Locale;
	competitorKey: CompetitorKey;
	competitor: CompetitorDetail;
}
const { locale, competitorKey, competitor: c } = Astro.props;
const dict = getDictionary(locale);
const otherKeys = competitorKeys.filter((k) => k !== competitorKey);
const [, competitorTitleName] = c.title.split(' vs ');
---
<section class="ct-section">
	<div class="ct-container ct-compare-head">
		<p class="ct-eyebrow">{c.eyebrow}</p>
		<h1><span class="ct-accent">clickTarot Calendar</span> vs {competitorTitleName}</h1>
		<p class="ct-hint">{c.subtitle}</p>
	</div>
</section>

<section class="ct-section">
	<div class="ct-container ct-compare-table-wrap">
		<table class="ct-compare">
			<thead>
				<tr>
					<th>{c.colFeature}</th>
					<th>{c.colClicktarot}</th>
					<th>{c.colCompetitor}</th>
				</tr>
			</thead>
			<tbody>
				{c.rows.map((row) => (
					<tr>
						<td class="ct-compare-feature">{row.feature}</td>
						<td class="ct-compare-us" data-label={c.colClicktarot}>{row.clicktarot}</td>
						<td class="ct-compare-them" data-label={c.colCompetitor}>{row.competitor}</td>
					</tr>
				))}
			</tbody>
		</table>
	</div>
</section>

<section class="ct-section ct-section-alt">
	<div class="ct-container ct-pain-points">
		<h2>{c.painPointsTitle}</h2>
		<p class="ct-hint">{c.painPointsIntro}</p>
		<ul>
			{c.painPoints.map((point) => (
				<li>{point}</li>
			))}
		</ul>
	</div>
</section>

{c.faq.length > 0 && (
	<section class="ct-section">
		<div class="ct-container ct-compare-faq">
			{c.faq.map((item) => (
				<div class="ct-card">
					<h3>{item.q}</h3>
					<p class="ct-hint">{item.a}</p>
				</div>
			))}
		</div>
	</section>
)}

{otherKeys.length > 0 && (
	<section class="ct-section">
		<div class="ct-container">
			<h2>{c.otherComparisonsTitle}</h2>
			<ul class="ct-other-compare-list">
				{otherKeys.map((k) => (
					<li>
						<a href={competitorPath(locale, k)}>vs {competitorNames[k]}</a>
					</li>
				))}
				{competitorKey === 'booknetic' && (
					<li>
						<a href={bookneticSaasPath(locale)}>vs Booknetic SaaS</a>
					</li>
				)}
			</ul>
		</div>
	</section>
)}

<section class="ct-section ct-section-alt">
	<div class="ct-container ct-final-cta">
		<h2>{c.ctaTitle}</h2>
		<p class="ct-hint">{c.ctaBody}</p>
		<CtaButton href={CHECKOUT_URL} external>{dict.pricing.ctaLabel}</CtaButton>
	</div>
</section>

<style>
	.ct-compare-head {
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
	}
	.ct-compare-table-wrap {
		overflow-x: auto;
	}
	table.ct-compare {
		border: none;
	}
	table.ct-compare th {
		background: var(--ct-primary-dark);
		color: #fff;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.03em;
	}
	table.ct-compare th:first-child {
		border-top-left-radius: var(--ct-radius);
	}
	table.ct-compare th:last-child {
		border-top-right-radius: var(--ct-radius);
	}
	td.ct-compare-feature {
		font-weight: 700;
		background: var(--ct-surface);
	}
	td.ct-compare-us {
		background: var(--ct-primary-tint);
		border-left: 3px solid var(--ct-primary);
		color: var(--ct-ink);
	}
	td.ct-compare-them {
		background: var(--ct-bg);
		color: var(--ct-ink-soft);
	}

	@media (max-width: 720px) {
		.ct-compare-table-wrap {
			overflow-x: visible;
		}
		table.ct-compare,
		table.ct-compare thead,
		table.ct-compare tbody,
		table.ct-compare tr,
		table.ct-compare td {
			display: block;
			width: 100%;
		}
		table.ct-compare thead {
			display: none;
		}
		table.ct-compare tr {
			margin-bottom: 16px;
			border: 1px solid var(--ct-border);
			border-radius: var(--ct-radius);
			overflow: hidden;
		}
		table.ct-compare tr:last-child {
			margin-bottom: 0;
		}
		table.ct-compare td {
			border-bottom: 1px solid var(--ct-border);
			border-left: none;
		}
		td.ct-compare-feature {
			font-size: 15px;
		}
		td.ct-compare-us,
		td.ct-compare-them {
			border-bottom: none;
		}
		td.ct-compare-us::before,
		td.ct-compare-them::before {
			content: attr(data-label);
			display: block;
			font-size: 11px;
			font-weight: 700;
			text-transform: uppercase;
			letter-spacing: 0.04em;
			margin-bottom: 4px;
			opacity: 0.75;
		}
		td.ct-compare-us {
			border-left: 3px solid var(--ct-primary);
		}
	}
	.ct-pain-points {
		max-width: 760px;
		margin: 0 auto;
	}
	.ct-pain-points ul {
		margin: 20px 0 0;
		padding-left: 20px;
		display: grid;
		gap: 12px;
	}
	.ct-pain-points li {
		color: var(--ct-ink-soft);
	}
	.ct-compare-faq {
		display: grid;
		gap: 16px;
		max-width: 760px;
		margin: 0 auto;
	}
	.ct-compare-faq h3 {
		margin: 0 0 8px;
		font-size: 17px;
	}
	.ct-compare-faq p {
		margin: 0;
	}
	.ct-final-cta {
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}
	.ct-final-cta p {
		margin: 12px 0 24px;
	}
	.ct-other-compare-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 12px;
		margin: 24px 0 0;
		padding: 0;
	}
	.ct-other-compare-list a {
		display: block;
		padding: 14px 16px;
		border: 1px solid var(--ct-border);
		border-radius: var(--ct-radius);
		color: var(--ct-ink);
		text-decoration: none;
		font-weight: 600;
	}
	.ct-other-compare-list a:hover {
		border-color: var(--ct-primary-dark);
		color: var(--ct-primary-dark);
	}
</style>
