---
import { getDictionary, type Locale } from '../i18n';
import { guideKeys, guidePath, getGuideDetail } from '../i18n/guides';
import CtaButton from '../components/CtaButton.astro';
import { getCheckoutUrl } from '../config';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const dict = getDictionary(locale);
---
<section class="ct-section">
	<div class="ct-container ct-guide-index-head">
		<p class="ct-eyebrow">{dict.guidesIndex.eyebrow}</p>
		<h1>{dict.guidesIndex.title}</h1>
		<p class="ct-hint">{dict.guidesIndex.subtitle}</p>
	</div>
</section>

<section class="ct-section">
	<div class="ct-container">
		<ul class="ct-guide-index-list">
			{guideKeys.map((key) => {
				const g = getGuideDetail(locale, key);
				return (
					<li>
						<a class="ct-card ct-guide-index-card" href={guidePath(locale, key)}>
							<h2>{g.title}</h2>
							<p class="ct-hint">{g.tagline}</p>
						</a>
					</li>
				);
			})}
		</ul>
	</div>
</section>

<section class="ct-section ct-section-alt">
	<div class="ct-container ct-final-cta">
		<h2>{dict.guidesIndex.ctaTitle}</h2>
		<p class="ct-hint">{dict.guidesIndex.ctaBody}</p>
		<CtaButton href={getCheckoutUrl(locale)} external>{dict.pricing.ctaLabel}</CtaButton>
		<p class="ct-hint ct-free-note" set:html={dict.pricing.freeVersionNote} />
	</div>
</section>

<style>
	.ct-guide-index-head {
		text-align: center;
		max-width: 720px;
		margin: 0 auto;
	}
	.ct-guide-index-list {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
		gap: 16px;
		margin: 0;
		padding: 0;
	}
	.ct-guide-index-card {
		display: block;
		color: var(--ct-ink);
		text-decoration: none;
		height: 100%;
	}
	.ct-guide-index-card h2 {
		margin: 0 0 8px;
		font-size: 18px;
	}
	.ct-guide-index-card p {
		margin: 0;
	}
	.ct-guide-index-card:hover {
		border-color: var(--ct-primary-dark);
	}
	.ct-guide-index-card:hover h2 {
		color: var(--ct-primary-dark);
	}
	.ct-final-cta {
		text-align: center;
		max-width: 640px;
		margin: 0 auto;
	}
	.ct-final-cta p {
		margin: 12px 0 24px;
	}
	.ct-free-note {
		margin: 12px 0 0;
		font-size: 13px;
	}
</style>
