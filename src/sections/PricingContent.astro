---
import { getDictionary, type Locale } from '../i18n';
import CtaButton from '../components/CtaButton.astro';
import { CHECKOUT_URL } from '../config';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const dict = getDictionary(locale);
---
<section class="ct-section">
	<div class="ct-container ct-pricing-head">
		<p class="ct-eyebrow">{dict.pricing.eyebrow}</p>
		<h1>{dict.pricing.title}</h1>
		<p class="ct-hint">{dict.pricing.subtitle}</p>
	</div>

	<div class="ct-container ct-pricing-card-wrap">
		<div class="ct-card ct-pricing-card">
			<h2>{dict.pricing.planName}</h2>
			<p class="ct-hint">{dict.pricing.priceNote}</p>
			<ul class="ct-included">
				{dict.pricing.included.map((item) => (
					<li>{item}</li>
				))}
			</ul>
			<CtaButton href={CHECKOUT_URL} external>{dict.pricing.ctaLabel}</CtaButton>
			<p class="ct-hint ct-guarantee">{dict.pricing.guarantee}</p>
		</div>
	</div>
</section>

<style>
	.ct-pricing-head {
		text-align: center;
		max-width: 680px;
		margin: 0 auto 40px;
	}
	.ct-pricing-card-wrap {
		display: flex;
		justify-content: center;
	}
	.ct-pricing-card {
		max-width: 460px;
		width: 100%;
		text-align: left;
	}
	.ct-pricing-card h2 {
		margin: 0 0 4px;
	}
	.ct-included {
		list-style: none;
		padding: 0;
		margin: 24px 0;
		display: grid;
		gap: 10px;
	}
	.ct-included li {
		padding-left: 26px;
		position: relative;
	}
	.ct-included li::before {
		content: '✓';
		position: absolute;
		left: 0;
		color: var(--ct-primary);
		font-weight: 700;
	}
	.ct-pricing-card .ct-btn {
		width: 100%;
	}
	.ct-guarantee {
		margin: 16px 0 0;
		font-size: 13px;
		text-align: center;
	}
</style>
