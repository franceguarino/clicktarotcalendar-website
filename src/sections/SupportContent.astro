---
import { getDictionary, type Locale } from '../i18n';
import CtaButton from '../components/CtaButton.astro';
import { CONTACT_EMAIL } from '../config';

interface Props {
	locale: Locale;
}
const { locale } = Astro.props;
const dict = getDictionary(locale);
---
<section class="ct-section ct-support-hero">
	<div class="ct-container ct-support-head">
		<p class="ct-eyebrow">{dict.support.eyebrow}</p>
		<h1>{dict.support.title}</h1>
		<p class="ct-hint">{dict.support.intro}</p>
	</div>
</section>

<section class="ct-section ct-support-toc-section">
	<div class="ct-container ct-support-toc-wrap">
		<nav class="ct-card ct-support-toc" aria-label={dict.support.tocLabel}>
			<p class="ct-support-toc-label">{dict.support.tocLabel}</p>
			<ol>
				{dict.support.sections.map((s) => (
					<li><a href={`#${s.id}`}>{s.title}</a></li>
				))}
				<li><a href="#faq">{dict.support.faqTitle}</a></li>
			</ol>
		</nav>
	</div>
</section>

<section class="ct-section">
	<div class="ct-container ct-support-body">
		{dict.support.sections.map((s, i) => (
			<article class="ct-card ct-support-block" id={s.id}>
				<h2>{i + 1}. {s.title}</h2>
				{s.paragraphs.map((p) => <p>{p}</p>)}
				{s.tip && <p class="ct-hint ct-support-tip">{s.tip}</p>}
			</article>
		))}

		<article class="ct-card ct-support-block" id="faq">
			<h2>{dict.support.faqTitle}</h2>
			<div class="ct-faq-list">
				{dict.support.faq.map((item) => (
					<details class="ct-support-faq-item">
						<summary>{item.q}</summary>
						<p class="ct-hint">{item.a}</p>
					</details>
				))}
			</div>
		</article>
	</div>
</section>

<section class="ct-section ct-section-alt">
	<div class="ct-container ct-support-contact">
		<h2>{dict.support.contactTitle}</h2>
		<p class="ct-hint">{dict.support.contactBody}</p>
		<CtaButton href={`mailto:${CONTACT_EMAIL}`} variant="secondary">{dict.support.contactCta}</CtaButton>
	</div>
</section>

<style>
	.ct-support-hero {
		padding-bottom: 0;
	}
	.ct-support-head {
		text-align: center;
		max-width: 680px;
		margin: 0 auto;
	}
	.ct-support-toc-section {
		padding-top: 24px;
		padding-bottom: 0;
	}
	.ct-support-toc-wrap {
		max-width: 760px;
		margin: 0 auto;
	}
	.ct-support-toc {
		padding: 20px 24px;
	}
	.ct-support-toc-label {
		margin: 0 0 10px;
		font-weight: 700;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--ct-ink-soft);
	}
	.ct-support-toc ol {
		margin: 0;
		padding: 0;
		list-style: none;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
		gap: 4px 20px;
		counter-reset: toc;
	}
	.ct-support-toc li {
		counter-increment: toc;
	}
	.ct-support-toc a {
		display: block;
		padding: 6px 0;
		color: var(--ct-ink);
		text-decoration: none;
		font-size: 14px;
		font-weight: 600;
	}
	.ct-support-toc a::before {
		content: counter(toc) '. ';
		color: var(--ct-primary-dark);
	}
	.ct-support-toc a:hover {
		color: var(--ct-primary-dark);
		text-decoration: underline;
	}
	.ct-support-body {
		max-width: 760px;
		margin: 0 auto;
		display: grid;
		gap: 20px;
	}
	.ct-support-block {
		scroll-margin-top: 90px;
	}
	.ct-support-block h2 {
		font-size: 19px;
		margin: 0 0 12px;
	}
	.ct-support-block p {
		margin: 0 0 12px;
		color: var(--ct-ink-soft);
	}
	.ct-support-block p:last-child {
		margin-bottom: 0;
	}
	.ct-support-tip {
		background: var(--ct-bg);
		border: 1px solid var(--ct-border);
		border-radius: var(--ct-radius);
		padding: 12px 14px;
		font-size: 14px;
	}
	.ct-faq-list {
		display: grid;
		gap: 12px;
	}
	.ct-support-faq-item summary {
		cursor: pointer;
		font-weight: 600;
		font-size: 15px;
		color: var(--ct-ink);
	}
	.ct-support-faq-item p {
		margin: 10px 0 0;
	}
	.ct-support-contact {
		text-align: center;
		max-width: 560px;
		margin: 0 auto;
	}
	.ct-support-contact p {
		margin: 12px 0 20px;
	}
</style>
